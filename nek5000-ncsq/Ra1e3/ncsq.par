[GENERAL] 
#startFrom = restart.f00010 time=2
stopAt = endTime
endTime = 100

variabledt = yes
targetCFL = 0.4

writeControl = runTime
writeInterval = 1

[PROBLEMTYPE]
equation = incompNS
stressFormulation = yes

[VELOCITY]
residualTol = 1e-06
density = 1
# mu = sqrt(g*beta*dT*L^3*rho^2*Pr/Ra)
# mu = sqrt(9.81*Pr/Ra)
viscosity = 0.0835

[TEMPERATURE]
rhoCp = 1.0
# k = sqrt(g*beta*dT*L^3*rho^2*Cp^2/(Pr*Ra))
# k = sqrt(9.81/(Pr*Ra))
conductivity = 0.1175


